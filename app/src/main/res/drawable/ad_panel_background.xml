<?xml version="1.0" encoding="utf-8"?>
<!-- Dark rounded panel with a thin grey frame (a lighter-to-darker gradient, top to bottom). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#262626"
                android:startColor="#4A4A4A" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#0B0B0B" />
        </shape>
    </item>
</layer-list>
